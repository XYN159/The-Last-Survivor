      {
        "id": "slot.left_only",
        "col": 2,
        "row": 4,
        "label": "只贴左路",
        "why": "中间是障碍，这一格打不到右路。左路要有自己的人。"
      },
      {
        "id": "slot.right_only",
        "col": 4,
        "row": 4,
        "label": "只贴右路",
        "why": "和左路那格对称，只覆盖右路。两边都空着，就会有一侧直接漏到汇合点。"
      },
      {
        "id": "slot.after_merge",
        "col": 4,
        "row": 9,
        "label": "汇合之后",
        "why": "两路已经并回一条。这里一个人能补两边漏下来的残影，是这张图后半的主阵地。"
      }
    ]
