  "offer_rules": {
    "trigger": "every_n_waves_cleared",
    "n_rules_key": "buff_offers.every_n_waves_cleared",
    "choices_stats_key": "buff_offer.choices",
    "distinct": true,
    "exclude_maxed": true,
