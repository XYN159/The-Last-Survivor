{
  "meta": {
    "schema_version": 5,
    "status": "draft",
    "owner": "combat_design",
    "doc": "docs/design/combat/core_rules.md",
    "stats_file": "data/balance/combat/stats.json",
    "stats_owner_zh": "数值以数值策划 PR #8 生成的 stats.json 为唯一来源；本文件只写行为，数字用 *_stats_key 引用",
    "superseded_note_zh": "2026-10-03：Q2 连续时间轴取代波次钟；Q3 同名只能一个；Q3b 点格子、点头像、选方向；Q5 删除共用符卡条；Q6 删除局内升级；Q12 主线无三选一；Q14 保底 0.05，通用暴击去掉。本文件里仍留着的 max_copies、upgrade、buff_offers、spell 能量、crit_roll 是旧字段，不当当前规则。"
  },
  "grid": {
    "columns": 7,
    "rows": 12,
    "origin": "top_left",
    "cell_size_px": 128,
    "board_offset_px": [
      92,
      140
    ]
  },
  "tick": {
    "logic_hz": 60,
    "max_ticks_per_frame": 4
  },
  "time_scale": {
    "speed_options": [
      1,
      2
    ],
    "default_speed": 1,
    "remember_last_speed": true
  },
  "battle_flow": {
    "deploy_time_sec": 10,
    "early_start_allowed": true,
    "intermission_sec": 4,
    "advance_mode": "spawn_window",
    "spawn_window_sec": 20,
    "wait_for_clear": false,
    "gap_starts_at": "spawn_window_end",
    "intermission_shortened_by_clear": false,
    "first_wave_delay_sec": 0,
    "deploy_wait_for_player_holds_full_countdown": true,
    "deploy_wait_for_player_releases_on": "first_placement",
    "tutorial_wave_count_may_be_below": 5,
    "level_wave_count_min": 10,
    "level_wave_count_max": 20,
    "mvp_wave_count_min": 10,
    "mvp_wave_count_max": 12,
    "early_call_allowed_states": [
      "deploy",
      "spawning",
      "intermission"
    ],
    "early_call_keeps_current_wave_spawns": true,
    "early_call_drops_unspawned": false,
    "early_call_skips_zh": "spawning 里叫波：跳过剩余刷怪窗口和空档，本波未出生的敌人按原时间表继续出生，与下一波重叠；intermission 里叫波：跳过剩余空档；deploy 里点开始：跳过剩余倒计时",
    "early_call_reward_rounding": "floor",
    "wave_clear_bonus_at": "intermission_start",
    "numbers_mirror_zh": "deploy_time_sec / intermission_sec / spawn_window_sec 与 stats.json → waves.deploy_time_sec / gap_sec / spawn_window_sec 相同（10 / 4 / 20）。程序以 stats.json 为准",
    "deploy_time_stats_key": "waves.deploy_time_sec",
    "intermission_stats_key": "waves.gap_sec",
    "spawn_window_stats_key": "waves.spawn_window_sec"
  },
  "targeting": {
    "default_rule": "closest_to_guard",
    "tie_breaker": "lowest_spawn_order",
    "deprioritize_invulnerable": true,
    "reevaluate_each_attack": true
  },
  "movement": {
    "min_speed_mult": 0.3,
    "max_speed_mult": 2.0,
    "boss_min_speed_mult": 0.5,
    "hard_stop_statuses": [
      "st_freeze",
      "st_time_stop",
      "st_hold",
      "st_gap_daze"
    ]
  },
  "knockback": {
    "default_cells": 0.1,
    "per_enemy_cooldown_sec": 0.25,
    "clamp_to_path_start": true
  },
  "enemy_spawn": {
    "spawn_state_sec": 0.3,
    "targetable_during_spawn": false
  },
  "guard": {
    "alert_rows_from_bottom": 2,
    "alert_throttle_real_sec": 2.0,
    "damage_vignette_sec": 0.4
  },
  "crisis": {
    "rows_from_bottom": 3,
    "guard_hp_ratio": 0.3,
    "charge_mult_stats_key": "spell_charge.crisis_charge_mult"
  },
  "spell_energy": {
    "max_stats_key": "characters.<caster_id>.spell_energy_max",
    "max_fallback_stats_key": "spell_charge.energy_max_default",
    "start_stats_key": "spell_charge.energy_start",
    "charge_from_spell_damage": false,
    "count_overkill": false,
    "auto_release_scope": "global",
    "auto_release_default_on": false,
    "auto_release_toggle_during_battle": true,
    "auto_release_min_enemies": 8,
    "auto_release_rows_from_bottom": 3,
    "caster_mode": "single_caster_switchable",
    "caster_switch_allowed_states": [
      "deploy",
      "intermission"
    ],
    "caster_switch_clears_charge": true,
    "caster_absent_origin": "guard",
    "caster_unfreeze_on_cast": true,
    "auto_release_disabled_in_tutorial": false
  },
  "spell_cutin": {
    "first_duration_sec": 1.2,
    "repeat_duration_sec": 0.6,
    "shorten_scope": "per_card_per_battle",
    "skippable": true,
    "pauses_logic": true
  },
  "combo": {
    "chain_window_sec": 1.0,
    "display_from": 3
  },
  "slowmo": {
    "kills_window_sec": 0.2,
    "kills_threshold": 8,
    "spell_kills_threshold": 5,
    "duration_real_sec": 0.5,
    "time_mult": 0.3,
    "cooldown_real_sec": 8.0
  },
  "damage": {
    "rounding": "round_half_away_from_zero",
    "armor_feedback_ratio": 0.5,
    "armor_feedback_throttle_sec": 0.5,
    "attack_mult_categories": [
      "buff",
      "aura",
      "temp"
    ],
    "damage_mult_buckets": [
      "vulnerability",
      "synergy"
    ],
    "multi_shot_split": {
      "rule": "total_damage_unchanged",
      "per_shot_skill_coef": "1/count",
      "per_shot_armor": "armor/count",
      "crit_roll": "removed",
      "applies_to": "attack.count > 1",
      "crit_note_zh": "通用暴击已去掉（Q14），不再每发掷暴击。"
    },
    "armor_floor_ratio": 0.05,
    "armor_floor_note_zh": "Q14：保底 5%。不另写别的伤害数字。结算用浮点。"
  },
  "placement": {
    "place_delay_sec": 0.3,
    "max_copies_per_character": 3,
    "per_character_max_copies_stats_key": "characters.<id>.max_copies",
    "sell_allowed_during_wave": true,
    "upgrade_allowed_during_wave": true,
    "allowed_cell_mark": ".",
    "routes_fixed_during_level": true
  },
  "character_levels": {
    "max_level": 3
  },
  "buff_offers": {
    "every_n_waves_cleared": 5,
    "choices": 3,
    "pauses_logic": true,
    "offer_after_boss_phase": false,
    "scope": "per_level",
    "clear_on_level_end": true,
    "allow_repeat_stacks": true,
    "prologue_levels_without_offer": 2,
    "prologue_offer_starts_at_level": 3,
    "pity_owned_below_threshold": true,
    "skip_offer_on_final_wave": true,
    "offer_trigger_point": "intermission_start_after_wave_spawn_window",
    "transform_at_stacks_stats_key": "buffs.<id>.transform_at_stacks",
    "transform_at_stacks_default_stats_key": "buff_offer.transform_at_stacks_default"
  },
  "performance": {
    "max_projectiles": 300,
    "max_damage_numbers": 40,
    "max_kill_orbs": 60
  },
  "rng": {
    "seeded_per_battle": true
  },
  "retry": {
    "on_defeat": [
      "restart_wave",
      "restart_level"
    ],
    "restart_wave_restore": "wave_start_snapshot",
    "snapshot_restores": [
      "guard_hp",
      "spirit",
      "placed_characters_with_level_and_cell",
      "buff_stacks",
      "spell_energy",
      "spell_caster",
      "field_enemies",
      "terrain_effects",
      "boss_hp_phase_position",
      "wave_timer",
      "rng_state"
    ],
    "snapshot_does_not_restore": [
      "combo",
      "discovered_synergies",
      "tutorial_flags"
    ]
  }
}
