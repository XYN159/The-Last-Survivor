{
  "schema_version": 1,
  "_owner": "数值策划",
  "note": "已确认的规则写在 confirmed。某一关要改波数或编组时，改 levels 里那一行的 wave_count，再改 data/levels 里对应的 waves，让每一波的威胁点刚好等于 10 + 4 × 波次。系数列先全部留 1.0，等数值策划决定要不要用。他们之后会另给一张每关波数和编组的模拟表。",
  "confirmed": {
    "per_wave_threat": "10 + 4 * wave_index",
    "wave_index_starts_at": 1,
    "examples": {
      "wave_1": 14,
      "wave_10": 50,
      "wave_15": 70
    },
    "level_total": "10 * N + 2 * N * (N + 1)",
    "known_totals": {
      "8": 224,
      "9": 270,
      "10": 320,
      "11": 374,
      "12": 432,
      "15": 630
    },
    "hp_multiplier": "1 + 0.15 * (level_number - 1)",
    "hp_base": "图鉴里的 hp 是第 1 关基础值，实战生命再乘本关 hp_multiplier",
    "starting_spirit_power": 150,
    "spirit_per_wave_survived": 20,
    "lives": 20,
    "buff_every_waves": 5,
    "buff_pick_count": 3,
    "boss_does_not_consume_wave_budget": true
  },
  "proposal": {
    "threat_budget_coef": {
      "default": 1.0,
      "status": "level_design_proposal_pending_numbers",
      "note": "关卡策划建议系数先全部用 1.0。松紧靠波数和编组：教学关波数少、大多是小残影；试炼关波数更多，并稍多放硬残影；首领关波数最多。数值策划还没决定要不要改这一列。"
    }
  },
  "alignment_open": [
    {
      "id": "threat_budget_coef_pending",
      "note": "威胁系数列保留，但全部写成 1.0，这是关卡策划的提议，等数值策划拍板。因此现在的章节回落不靠系数。首领 15 波合计 630，下一章第 1 关草案是 8 波合计 224。第一章第 1 关和序章第 3 关都是 10 波，合计都是 320；手感变松靠编组和小残影，不靠把预算乘小。"
    },
    {
      "id": "half_lives_sits_on_star_boundary",
      "numbers_target_lives_remaining": 10,
      "level_design_proposal_lives_remaining": "11-13",
      "note": "上一轮希望首通大约剩 10 命。这一轮没有确认这个目标，星级区间也没改。1 到 9 是 1 星，10 到 17 是 2 星，10 仍踩在交界上。关卡策划仍建议瞄准剩余 11 到 13。"
    }
  ],
