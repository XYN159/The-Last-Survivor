# Godot 4 editor cache and import output
.godot/
.import/

# Godot 4.2+ generated native libraries
~*.dll

# Local export credentials and temporary files. Presets stay committed.
export.cfg
export_credentials.cfg
*.tmp
*.translation

# Build output and Android packages. CI uploads these as artifacts.
/build/
*.apk
*.aab
*.idsig

# Gradle Android template generated by the editor. Do not commit it.
/android/

# Keystores and secrets. CI generates a debug keystore at runtime.
*.keystore
*.jks
*.key
.env
.env.*

# Mono / .NET leftovers, in case a local .NET editor is opened by mistake
.mono/
data_*/
mono_crash.*.json

# Python tooling
.venv/
__pycache__/
*.pyc

# Editors and operating systems
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
