; Engine configuration file.
; Godot 版本以仓库根目录的 godot-version.txt 为准。

config_version=5

[application]

config/name="东方守幻录"
config/description="东方Project 同人角色塔防。个人制作，免费，非商业。不是弹幕射击。"
config/version="0.1.0"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
run/flush_stdout_on_print=true

[autoload]

AppTheme="*res://scripts/autoload/app_theme.gd"
GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
; 本轮只让标题和序章第一关按 16:9 横屏排版，不代表整部游戏已确定改为横屏。
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[internationalization]

locale/fallback="zh_CN"
locale/translations=PackedStringArray("res://locale/game_zh.zh_CN.translation")

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
